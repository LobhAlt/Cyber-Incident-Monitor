# ── CIMI configuration ─────────────────────────────────────────────────────
# Copy to .env and fill in. Only the API keys are genuinely needed; everything
# else has a sensible default.

# Server
PORT=3000
NODE_ENV=production
# Host port to publish when using docker compose (container always listens on 3000)
HOST_PORT=3000
# Public hostname — only needed for `docker compose --profile tls` (automatic HTTPS)
# DOMAIN=cimi.example.com

# Sessions. Leave blank: a secret is generated once and stored in data/jwt.secret.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First-boot admin account (only used when users.json is empty)
DEFAULT_ADMIN_USER=analyst
DEFAULT_ADMIN_PASSWORD=Cimi@2026

# Threat-intelligence providers. Without a key that source uses the offline simulator.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Force the simulator even if keys are present
FORCE_DEMO_MODE=false

# ── Public site ────────────────────────────────────────────────────────────
# Canonical URL used in robots.txt / sitemap.xml (defaults to the request host)
# PUBLIC_URL=https://cimi.example.com
# Redirect plain HTTP to HTTPS (turn on when behind a TLS proxy such as the Caddy profile)
FORCE_HTTPS=false
# Allow visitors to create their own analyst accounts. Set false for a private instance.
ALLOW_REGISTRATION=true

# ── Email (account confirmation) ───────────────────────────────────────────
# New accounts must confirm their email before they can sign in. Without
# SMTP_HOST the confirmation link is printed in the server terminal instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>.
# Set PUBLIC_URL above when deployed, so links in emails point at your site.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CIMI <no-reply@your-domain>
# How long a confirmation link stays valid (milliseconds, default 24 hours)
# EMAIL_VERIFY_TTL_MS=86400000
# Optional cookie-less analytics (Plausible). Loaded only after the visitor allows it.
# PLAUSIBLE_DOMAIN=cimi.example.com
# PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Background refresh of CERT-In / CISA KEV feeds
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MS=3600000

# Cache / rate-limit tuning (milliseconds / request counts)
# CACHE_TTL_MS=900000
# CISA_CACHE_TTL_MS=21600000
# CERTIN_CACHE_TTL_MS=21600000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Where flat-file state is stored (defaults to ./data)
# DATA_DIR=/app/data
