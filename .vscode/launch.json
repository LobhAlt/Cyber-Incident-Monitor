{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start CIMI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch.js",
      "console": "integratedTerminal",
      "env": { "OPEN_BROWSER": "false" },
      "serverReadyAction": {
        "pattern": "URL\\s+(http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
